<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Blake3.Managed</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS1591</NoWarn>
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <!-- NuGet package metadata -->
    <PackageId>Blake3.Managed</PackageId>
    <Title>BLAKE3 for .NET (pure C#)</Title>
    <Description>BLAKE3 cryptographic hash function for .NET in pure managed C# — no native libraries, no P/Invoke. SIMD accelerated (AVX2, SSE/SSSE3, ARM NEON) with multithreaded hashing of large inputs; faster than SHA-256 and MD5. Supports keyed hashing (MAC), key derivation (KDF) and extendable output (XOF), plus a HashAlgorithm adapter and a hashing Stream wrapper. A fully managed, AOT-friendly alternative to native BLAKE3 wrappers — ideal for checksums, content addressing, deduplication and file integrity. Runs everywhere .NET runs, with automatic scalar fallback.</Description>
    <Authors>Marius Vitkevičius</Authors>
    <Copyright>Copyright (c) 2026 Marius Vitkevičius</Copyright>
    <PackageTags>blake3;blake;hash;hashing;hash-function;cryptography;crypto;security;checksum;integrity;digest;sha256;simd;avx2;sse;neon;intrinsics;managed;kdf;mac;xof;merkle-tree;aot;csharp;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Dissimilis/Blake3.Managed</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Dissimilis/Blake3.Managed</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blake3.Managed.Tests" />
    <InternalsVisibleTo Include="Blake3.Managed.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\img\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
